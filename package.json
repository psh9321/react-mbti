{
  "name": "react-project01",
  "private": true,
  "packageManager": "pnpm@10.2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "server-debug": "NODE_ENV=development nodemon --watch server --ext ts --exec \"tsx --tsconfig server/tsconfig.json\" server/index.ts",
    "preview": "NODE_ENV=production tsx --tsconfig server/tsconfig.json server/index.ts",
    "start": "pm2 start ecosystem.config.cjs --env production",
    "reload": "pm2 reload ecosystem.config.cjs",
    "test": "vitest run",
    "test-client": "vitest run test/src",
    "test-server": "vitest run --project server"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@parksuhyun9321/use-media-query": "^1.0.17",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "dotenv": "^17.4.2",
    "fs": "0.0.1-security",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "ky": "^2.2.0",
    "lucide-react": "^1.61.0",
    "pm2": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
